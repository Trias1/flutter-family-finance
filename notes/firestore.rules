rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User documents — each user can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections under users (wallets, transactions, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Family collections — members of a family can access shared data
    match /families/{familyId} {
      allow read, write: if request.auth != null
        && request.auth.token.family_id == familyId;

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.token.family_id == familyId;
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
