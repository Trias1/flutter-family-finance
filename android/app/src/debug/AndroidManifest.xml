<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Reading bank notifications is still being built, so it is in debug
         builds only: Google Play Protect blocks installing an APK from the
         web when it can ask for Notification access (Indonesia). -->
    <application>
        <service
            android:name=".BankNotificationListener"
            android:exported="false"
            android:label="Family Finance"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
